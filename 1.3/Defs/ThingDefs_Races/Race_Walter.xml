				</capacities>
				<power>3</power>
				<cooldownTime>1.2</cooldownTime>
				<linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
				<surpriseAttack>
					<extraMeleeDamages>
						<li>
							<def>Stun</def>
							<amount>22</amount>
						</li>
					</extraMeleeDamages>
				</surpriseAttack>
			</li>
			<li>
