			<li>
    <options>
      <li>
        <defName Degree="0">Emotionless</defName>
      </li>     
    </options>    
    <chance>100</chance>
  </li>
	<li>
    <options>
      <li>
        <defName Degree="0">Kind</defName>
      </li>     
    </options>    
    <chance>100</chance>
  </li>		
			<li>
    <options>
      <li>
        <defName Degree="0">Tough</defName>
      </li>     
    </options>    
    <chance>100</chance>
  </li>			
		</forcedRaceTraitEntries>
		<maleGenderProbability>1</maleGenderProbability>
		<immuneToAge>true</immuneToAge>
