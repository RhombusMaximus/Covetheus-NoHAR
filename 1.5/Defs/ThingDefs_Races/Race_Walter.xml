<AlienRace.ThingDef_AlienRace ParentName="Human">
	<defName>Android_Walter</defName>
	<label>Walter</label>
	<description>The world's most advanced synthetic companion. It seems that the human qualities of the David 8 series left people uncomfortable, especially the displays of ego, vanity, and pride. This lead to this new model, which lacks human qualities altogether.</description>
	<alienRace>
	<generalSettings>		
	<minAgeForAdulthood>0</minAgeForAdulthood>
	<allowHumanBios>false</allowHumanBios>
