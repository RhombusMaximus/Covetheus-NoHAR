<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Walter android blood: white milky synthetic fluid.
       Graphic_Single (Graphic_Random fails with BaseFilth parent —
       same issue seen in AVP-Xenomorphs blood defs).
       Uses the first splatter variant from the WalterBlood set. -->
  <ThingDef ParentName="BaseFilth">
    <defName>LBC_FilthBloodWalter</defName>
    <label>synthetic fluid</label>
    <statBases>
      <Beauty>-14</Beauty>
      <Cleanliness>-10</Cleanliness>
    </statBases>
    <graphicData>
      <texPath>Things/Filth/WalterBlood_a</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <filth>
      <rainWashes>true</rainWashes>
      <cleaningWorkToReduceThickness>90</cleaningWorkToReduceThickness>
      <canFilthAttach>true</canFilthAttach>
    </filth>
  </ThingDef>

</Defs>