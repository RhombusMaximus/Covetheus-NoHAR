<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Walter android blood: white milky synthetic fluid.
       Uses the same splatter art as AVP-Xenomorphs blood, tinted white. -->
  <ThingDef ParentName="BaseFilth">
    <defName>LBC_FilthBloodWalter</defName>
    <label>synthetic fluid</label>
    <statBases>
      <Beauty>-14</Beauty>
      <Cleanliness>-10</Cleanliness>
    </statBases>
    <graphicData>
      <texPath>Things/Filth/WalterBlood</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <filth>
      <rainWashes>true</rainWashes>
      <cleaningWorkToReduceThickness>90</cleaningWorkToReduceThickness>
      <canFilthAttach>true</canFilthAttach>
    </filth>
  </ThingDef>

</Defs>